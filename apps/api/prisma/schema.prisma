// ==========================================
// CONFIGURACIÓN INICIAL
// ==========================================
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// ENUMS
// ==========================================
enum RolUsuario {
  ADMIN
  PACIENTE
  KINESIOLOGO
  OWNER
}

enum TipoPlan {
  PARTICULAR
  FIJO
}

enum DiaSemana {
  LUNES
  MARTES
  MIERCOLES
  JUEVES
  VIERNES
  SABADO
  DOMINGO
}

enum EstadoTurno {
  DISPONIBLE
  RESERVADO
  CANCELADO
}

enum EstadoReserva {
  PENDIENTE
  CONFIRMADA
  CANCELADA
  ASISTIO
  AUSENTE
}

enum MetodoPago {
  EFECTIVO
  TARJETA
  TRANSFERENCIA
  MERCADOPAGO
}

enum EstadoPago {
  PENDIENTE
  COMPLETADO
  RECHAZADO
  REEMBOLSADO
}

enum TipoNotificacion {
  RECORDATORIO
  CANCELACION_TURNO
  PROMOCION
  INFORMATIVA
}

enum CanalNotificacion {
  EMAIL
  WHATSAPP
  SMS
}

enum EstadoNotificacion {
  PENDIENTE
  ENVIADA
  ERROR
}

// 1. NUEVO ENUM PARA LA LISTA DE ESPERA
enum EstadoListaEspera {
  PENDIENTE
  NOTIFICADO
  ASIGNADO
  CANCELADO
  EXPIRADO
}

// ==========================================
// MODELOS (Tablas)
// ==========================================

model Usuario {
  id               Int        @id @default(autoincrement())
  nombre           String
  apellido         String
  dni              String     @unique
  telefono         String     @unique
  email            String     @unique
  contrasena       String
  rol              RolUsuario
  fecha_registro   DateTime   @default(now()) @db.Date
  
  intentosFallidos Int        @default(0)
  bloqueado        Boolean    @default(false)
  token            String?    @unique 

  paciente         Paciente?
  kinesiologo      Kinesiologo?
}

model Paciente {
  id                 Int       @id @default(autoincrement())
  usuario_id         Int       @unique
  usuario            Usuario   @relation(fields: [usuario_id], references: [id])
  tipo_plan          TipoPlan
  fecha_nacimiento   DateTime  @db.Date
  ausenciasMesActual Int       @default(0)

  reservas           Reserva[]
  lista_espera       ListaEspera[]
  descuentos         Descuento[]
  notificaciones     Notificacion[]
}

model Kinesiologo {
  id          Int       @id @default(autoincrement())
  usuario_id  Int       @unique
  usuario     Usuario   @relation(fields: [usuario_id], references: [id])

  actividades Actividad[]
}

model TipoActividad {
  id          Int       @id @default(autoincrement())
  nombre      String    @unique
  precio      Decimal   @db.Decimal(10, 2)

  actividades Actividad[]
  turnos      Turno[]
}

model Actividad {
  id               Int           @id @default(autoincrement())
  tipoActividad_id Int
  tipoActividad    TipoActividad @relation(fields: [tipoActividad_id], references: [id])
  kinesiologo_id   Int
  kinesiologo      Kinesiologo   @relation(fields: [kinesiologo_id], references: [id])
  dia_semana       DiaSemana
  hora_inicio      DateTime      @db.Time
  hora_fin         DateTime      @db.Time
  fecha_desde      DateTime      @db.Date
  fecha_hasta      DateTime?     @db.Date
}

model Turno {
  id                  Int           @id @default(autoincrement())
  tipoActividad_id    Int
  tipoActividad       TipoActividad @relation(fields: [tipoActividad_id], references: [id])
  fecha               DateTime      @db.Date
  hora_inicio         DateTime      @db.Time
  estado              EstadoTurno   @default(DISPONIBLE)
  capacidad           Int
  cantidad_inscriptos Int           @default(0)

  reservas            Reserva[]
  lista_espera        ListaEspera[]

  @@unique([fecha, hora_inicio, tipoActividad_id])
}

model Reserva {
  id                    Int           @id @default(autoincrement())
  turno_id              Int
  turno                 Turno         @relation(fields: [turno_id], references: [id])
  paciente_id           Int
  paciente              Paciente      @relation(fields: [paciente_id], references: [id])
  estado                EstadoReserva @default(PENDIENTE)
  fecha_reserva         DateTime      @default(now())
  cant_reprogramaciones Int           @default(0)

  pagos                 Pago[]
  notificaciones        Notificacion[]
}

model Pago {
  id                        Int        @id @default(autoincrement())
  reserva_id                Int
  reserva                   Reserva    @relation(fields: [reserva_id], references: [id])
  monto                     Decimal    @db.Decimal(10, 2)
  metodo                    MetodoPago
  estado                    EstadoPago @default(PENDIENTE)
  fecha_pago                DateTime?
  comprobante               String?
  mercadopago_preference_id String?
  mercadopago_payment_id    String?
}

// 2. MODELO REFACTORIZADO: LISTA DE ESPERA
model ListaEspera {
  id                 Int               @id @default(autoincrement())
  turno_id           Int
  turno              Turno             @relation(fields: [turno_id], references: [id])
  paciente_id        Int
  paciente           Paciente          @relation(fields: [paciente_id], references: [id])
  prioridad          Int               
  grupo_fijo_id      String?  
  total_sesiones     Int      @default(1) 
  sesiones_pendientes Int     @default(1) 
  estado             EstadoListaEspera @default(PENDIENTE)
  fecha_anotacion    DateTime          @default(now())
  fecha_notificacion DateTime?         
}

model Descuento {
  id            Int      @id @default(autoincrement())
  paciente_id   Int
  paciente      Paciente @relation(fields: [paciente_id], references: [id])
  porcentaje    Decimal  @db.Decimal(5, 2)
  motivo        String
  mes_aplicable DateTime @db.Date
  utilizado     Boolean  @default(false)
}

model Notificacion {
  id          Int                @id @default(autoincrement())
  paciente_id Int
  paciente    Paciente           @relation(fields: [paciente_id], references: [id])
  reserva_id  Int?
  reserva     Reserva?           @relation(fields: [reserva_id], references: [id])
  tipo        TipoNotificacion
  canal       CanalNotificacion
  fecha_envio DateTime           @default(now())
  titulo      String
  descripcion String
  leida       Boolean            @default(false)
  estado      EstadoNotificacion @default(PENDIENTE)
}

// 3. NUEVO MODELO: CONFIGURACIÓN DEL SISTEMA
model ConfiguracionSistema {
  id                    Int @id @default(1) 
  porcentajeListaEspera Int @default(20)    
  contadorRespiracion   Int @default(0)
  horasExpiracionEspera Float @default(12.0)    
}